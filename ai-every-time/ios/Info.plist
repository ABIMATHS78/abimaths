<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AIETSiteURL</key>
	<string>$(AIET_SITE_URL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>To take a photo for your profile or for a companion you design, when you choose to.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>To ask your companion a question by voice, when you tap the microphone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save an image you choose to keep, such as your certificate.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To turn what you say into text when you ask your companion a question by voice.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
