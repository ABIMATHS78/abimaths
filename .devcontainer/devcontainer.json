// Opens AI Every Time in GitHub Codespaces (or any dev container) with the app installed and running:
// the site opens in a browser tab on port 8000. Without a Claude API key it runs in demo mode.
{
  "name": "AI Every Time",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install --user -r ai-every-time/requirements.txt -r ai-every-time/requirements-dev.txt",
  "postAttachCommand": {
    "app": "cd ai-every-time && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  // If the port is made public, anyone with its address can use the app and the AI on your key:
  // this caps everyone's AI requests together (admins aren't held to it).
  "containerEnv": { "AIET_AI_SITE_LIMIT": "200" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "AI Every Time", "onAutoForward": "openBrowser" }
  },
  // Asked for when the codespace is created. Both are optional.
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Your Claude API key, for real AI replies and content. Leave it empty for demo mode.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    },
    "ANTHROPIC_WORKSPACE_ID": {
      "description": "Only if your API key works across Claude workspaces (it says so when AI isn't working): the ID of the workspace to use, starting wrkspc_.",
      "documentationUrl": "https://platform.claude.com/settings/workspaces"
    },
    "AIET_ADMIN_EMAILS": {
      "description": "Your email address. Sign up with it to see the Staff pages, including Insights."
    }
  }
}
