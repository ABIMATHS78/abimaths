{% extends "_base.html.j2" %}
{% block style %}
.head { flex: none; text-align: center; margin-bottom: 26px; font-size: 104px; max-height: 300px; }
.head h1 { margin: 0; font-size: 1em; }
.head .sub { font-family: "Fraunces", serif; font-size: .38em; font-weight: 400; margin-top: .05em; font-variation-settings: "opsz" 72; }
.stack { font-size: 24px; display: flex; flex-direction: column; justify-content: center; }
.half { position: relative; display: flex; flex-direction: column; align-items: center; gap: .34em; }
.bar { border-radius: .4em; padding: .3em .8em; text-align: center; line-height: 1.18; font-weight: 500; }
.lbl { position: absolute; left: 0; font-weight: 800; font-size: .82em; text-transform: uppercase; letter-spacing: .04em; color: var(--ink); max-width: 9em; line-height: 1.15; }
.top .lbl { top: .4em; }
.bottom .lbl { bottom: .4em; }
.rule { height: .12em; background: var(--ink); margin: .85em 0; border-radius: .1em; }
{% endblock %}

{% block content %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="fit stack" data-fit="bars" data-fit-max="1.4" data-fit-min="0.45">
  <div class="half top">
    <div class="lbl" data-anim="fade">{{ data.top_label | rich }}</div>
    {% for bar in top_bars %}<div class="bar" style="width: {{ bar.w | round(1) }}%; background: {{ bar.bg }}; color: {{ bar.fg }}" data-anim="grow-x" data-dur="0.45">{{ bar.text | rich }}</div>{% endfor %}
  </div>
  <div class="rule" data-anim="grow-x"></div>
  <div class="half bottom">
    {% for bar in bottom_bars %}<div class="bar" style="width: {{ bar.w | round(1) }}%; background: {{ bar.bg }}; color: {{ bar.fg }}" data-anim="grow-x" data-dur="0.45">{{ bar.text | rich }}</div>{% endfor %}
    <div class="lbl" data-anim="fade">{{ data.bottom_label | rich }}</div>
  </div>
</section>
{% endblock %}
{% block script %}
<script>
// Centre the bars on the page: a bar's grow animation starts from its middle.
document.querySelectorAll(".bar").forEach((b) => (b.style.transformOrigin = "50% 50%"));
</script>
{% endblock %}
