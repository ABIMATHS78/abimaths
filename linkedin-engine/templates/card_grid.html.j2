{% extends "_base.html.j2" %}
{% set facets = data.style == "facets" %}
{% block style %}
.head { flex: none; text-align: center; margin-bottom: 26px; font-size: 92px; max-height: 260px; }
.head h1 { font-size: 1em; }
.head .sub { font-family: "Inter", sans-serif; font-size: .3em; font-weight: 500; letter-spacing: -.01em; color: var(--ink-2); margin-top: .4em; }
.grid { display: flex; flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 1em; padding: .4em .3em 1em; }
.card { width: calc((100% - {{ cols - 1 }} * 1em) / {{ cols }}); position: relative; }
.card.paper { background: #FFFDF9; box-shadow: 0 .35em 1.1em rgba(60, 40, 20, .14), 0 .05em .2em rgba(60, 40, 20, .1); padding: 1.15em 1em 1.2em; text-align: center; }
.card.paper::after { content: ""; position: absolute; inset: .42em; border: .06em solid var(--line); pointer-events: none; }
.card .num { font-family: "Fraunces", serif; font-weight: 600; font-size: 2.3em; line-height: 1; color: var(--accent); letter-spacing: -.02em; }
.card h3 { font-family: "Fraunces", serif; font-weight: 600; font-size: 1.2em; line-height: 1.08; color: var(--accent-2); margin-top: .1em; }
.card .tag { display: inline-block; font-family: "JetBrains Mono", monospace; font-size: .66em; background: var(--chip-bg); color: var(--chip-ink); padding: .15em .45em; border-radius: .2em; margin-top: .45em; }
.card .rule { width: 2.4em; height: .06em; background: var(--line); margin: .65em auto .55em; }
.card p { margin: 0; font-size: .84em; line-height: 1.32; color: var(--ink-2); }
.card .quote { margin-top: .6em; font-family: "Fraunces", serif; font-style: italic; font-size: .84em; line-height: 1.25; color: var(--ink); }
/* facets */
.card.facet { background: var(--panel); border: .22em solid var(--accent); border-radius: 1.1em; padding: .95em 1.05em 1.05em; text-align: left; }
.card.facet h3 { display: inline-block; background: var(--ink); color: var(--bg); font-family: "Inter", sans-serif; font-weight: 800; font-size: 1.05em; padding: .25em .6em; border-radius: .28em; margin: 0 0 .2em; }
.card.facet .lbl { font-size: .64em; font-weight: 800; letter-spacing: .09em; color: var(--accent-2); text-transform: uppercase; margin-top: .75em; }
.card.facet .txt { font-size: .9em; line-height: 1.3; margin-top: .15em; }
.card.facet .txt.big { font-family: "Fraunces", serif; font-weight: 500; font-size: 1.05em; background: var(--bg-2); padding: .35em .5em; border-radius: .2em; }
{% endblock %}

{% block content %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="fit" data-fit="cards" data-fit-max="1.5" data-fit-min="0.45" style="font-size: 21px">
  <div class="grid">
  {% for card in data.cards %}
    {% if facets %}
    <article class="card facet" data-anim="fade-up">
      <h3>{{ card.title | rich }}</h3>
      {% if card.text %}<div class="txt big">{{ card.text | rich }}</div>{% endif %}
      {% for facet in card.facets %}<div class="lbl">{{ facet.label }}</div><div class="txt">{{ facet.text | rich }}</div>{% endfor %}
    </article>
    {% else %}
    <article class="card paper" data-anim="pop">
      {% if data.numbered %}<div class="num">{{ "%02d" | format(loop.index) }}</div>{% endif %}
      <h3>{{ card.title | rich }}</h3>
      {% if card.tag %}<span class="tag">{{ card.tag }}</span>{% endif %}
      <div class="rule"></div>
      {% if card.text %}<p>{{ card.text | rich }}</p>{% endif %}
      {% if card.quote %}<div class="quote">{{ card.quote | rich }}</div>{% endif %}
    </article>
    {% endif %}
  {% endfor %}
  </div>
</section>
{% endblock %}
