{% extends "_base.html.j2" %}
{% block style %}
.canvas { padding: 0 64px; background: #111; }
.bg { position: absolute; inset: -60px; background: #1b1b1b center / cover no-repeat; filter: blur(36px) brightness(.42) saturate(1.1); }
.frame { position: absolute; left: 50%; top: {{ ((height - 76) / 2) | round }}px; width: {{ frame_w }}px; height: {{ frame_h }}px; transform: translate(-50%, -50%); }
.frame img { width: 100%; height: 100%; display: block; border-radius: 16px; box-shadow: 0 24px 70px rgba(0, 0, 0, .55); object-fit: contain; background: #fff; }
.frame .missing { width: 100%; height: 100%; border: 4px dashed #777; border-radius: 16px; display: grid; place-items: center; color: #bbb; font-size: 30px; text-align: center; padding: 40px; }
.hl { position: absolute; border: 9px solid #F0352B; border-radius: 6px; box-shadow: 0 0 0 2px rgba(0, 0, 0, .2); }
.stickers { position: absolute; inset: 0 0 76px 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 34px; }
.sticker { background: #0D0D0D; color: #fff; font-family: "Anton", Impact, sans-serif; text-transform: uppercase; font-size: 86px; line-height: 1; padding: 18px 34px 16px; border-radius: 20px; max-width: 88%; text-align: center; box-shadow: 0 12px 34px rgba(0, 0, 0, .4); }
.sticker:nth-child(odd) { transform: rotate(-1.4deg); }
.sticker:nth-child(even) { transform: rotate(1.1deg); }
.credit { position: relative; color: #CFCFCF; }
.credit b, .credit .right b { color: #fff; }
{% endblock %}

{% block content %}
<div class="bg"{% if image_uri %} style="background-image: url('{{ image_uri }}')"{% endif %}></div>
<div class="frame" data-anim="zoom">
  {% if image_uri %}<img src="{{ image_uri }}" alt="">{% else %}<div class="missing">Add the author's screenshot:<br>set "image" to its file path</div>{% endif %}
  {% for box in data.boxes %}<div class="hl" style="left: {{ box.x }}%; top: {{ box.y }}%; width: {{ box.w }}%; height: {{ box.h }}%" data-anim="pop"></div>{% endfor %}
</div>
<div class="stickers">
  {% for sticker in data.stickers %}<div class="sticker" data-anim="pop">{{ sticker | rich }}</div>{% endfor %}
</div>
{% endblock %}
