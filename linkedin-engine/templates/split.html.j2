{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import burst %}
{% set nl = data.left["items"] | length %}
{% set nr = data.right["items"] | length %}
{% set left_share = [[nl / ((nl + nr) or 1), 0.42] | max, 0.58] | min %}
{% block style %}
.head { flex: none; position: relative; z-index: 1; text-align: center; margin: 74px 0 40px; font-size: 104px; max-height: 330px; }
.head h1 { margin: 0; font-size: 1em; }
.head .sub { font-family: "Fraunces", serif; font-size: .34em; font-weight: 400; color: var(--muted); margin-top: .25em; }
.cols { display: grid; min-height: 100%; grid-template-columns: {{ (left_share * 100) | round(1) }}fr {{ ((1 - left_share) * 100) | round(1) }}fr; gap: .9em; align-items: stretch; }
.col { border-radius: .45em; overflow: hidden; display: flex; flex-direction: column; }
.col h2 { margin: 0; padding: .45em .8em .4em; font-size: 1.35em; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.col ul { margin: 0; padding: .8em .95em 1em 1.05em; list-style: none; display: flex; flex-direction: column; gap: .55em; flex: 1; }
.fit.stretched .col ul { justify-content: space-evenly; }
.col li { position: relative; padding-left: .95em; line-height: 1.25; }
.col li::before { content: ""; position: absolute; left: 0; top: .52em; width: .34em; height: .34em; border-radius: 50%; background: currentColor; opacity: .85; }
.col.numbered ul { counter-reset: n; }
.col.numbered li { counter-increment: n; padding-left: 1.5em; }
.col.numbered li::before { content: counter(n) "."; width: auto; height: auto; background: none; top: 0; font-weight: 800; opacity: 1; border-radius: 0; }
.tone-bad { background: var(--bad); color: var(--bad-ink); }
.tone-bad h2 { background: color-mix(in srgb, var(--bad) 72%, black); }
.tone-good { background: var(--good); color: var(--good-ink); }
.tone-good h2 { background: color-mix(in srgb, var(--good) 72%, black); color: #fff; }
.tone-neutral { background: var(--panel); color: var(--ink); border: .08em solid var(--line); }
.tone-neutral h2 { background: var(--panel-head); color: var(--panel-head-ink); }
.tone-accent { background: var(--accent); color: var(--accent-ink); }
.tone-accent h2 { background: var(--accent-2); }
.col strong { font-weight: 800; }
{% endblock %}

{% block script %}
<script>window.__layout = function () { document.querySelector('.fit').classList.add('stretched'); };</script>
{% endblock %}

{% block content %}
{{ burst(230, 12, "-80px", "-80px", "left") }}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="fit" data-fit="columns" data-fit-max="1.75" data-fit-min="0.45" style="font-size: 23px">
  <div class="cols">
    {% for side in [data.left, data.right] %}
    <div class="col tone-{{ side.tone }}{{ ' numbered' if data.numbered else '' }}" data-anim="fade-up">
      <h2>{{ side.label | rich }}</h2>
      <ul>{% for item in side["items"] %}<li data-anim="fade" data-weight="0.6">{{ item | rich }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
