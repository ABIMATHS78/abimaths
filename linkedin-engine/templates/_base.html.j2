<!doctype html>
<html lang="en" class="{{ 'motion' if motion else 'static' }}">
<head>
<meta charset="utf-8">
<title>{{ page_title }}</title>
<style>
{{ font_faces | safe }}
:root { --w: {{ width }}px; --h: {{ height }}px; {{ theme_css | safe }} }
{{ base_css | safe }}
{% block style %}{% endblock %}
</style>
</head>
<body>
<main class="canvas {% block canvas_class %}{% endblock %}" id="canvas">
{% block content %}{% endblock %}
{% if footer_left or footer_right %}
<footer class="credit" data-guard="footer">
  <span class="left">{{ footer_left | rich }}</span>
  <span class="right">{{ footer_right | rich }}</span>
</footer>
{% endif %}
</main>
<script>
window.__motionConfig = {{ motion_config | tojson }};
{{ runtime_js | safe }}
</script>
{% block script %}{% endblock %}
</body>
</html>
