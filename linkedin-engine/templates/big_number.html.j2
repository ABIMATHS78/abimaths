{% extends "_base.html.j2" %}
{% set n = data.bars | length %}
{% block style %}
.head { flex: none; text-align: center; margin-bottom: 20px; font-size: 104px; max-height: 280px; }
.head h1 { font-family: "Inter", sans-serif; font-weight: 800; letter-spacing: -.05em; line-height: 1; color: #3A3A3A; }
.head h1 em.accent { color: var(--accent); }
.head .sub { font-size: .32em; font-weight: 500; color: #555; letter-spacing: -.01em; margin-top: .45em; }
.head .sub strong { color: var(--accent); font-weight: 750; }
.chart { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: repeat({{ n }}, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr) auto auto; column-gap: 4%; padding: 0 5%; }
.slot { grid-row: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; min-height: 0; padding-top: 1.4em; position: relative; z-index: 1; }
.baseline { grid-row: 1; grid-column: 1 / -1; align-self: end; border-bottom: 3px solid #D6D6D6; margin: 0 -4%; }
.bar { width: 68%; background: repeating-linear-gradient(180deg, #A9A9A9 0 34px, #9C9C9C 34px 36px); border-radius: 3px 3px 0 0; position: relative; }
.bar.hl { background: var(--accent); }
.bar .in { position: absolute; top: .55em; left: 0; right: 0; text-align: center; color: #fff; font-weight: 800; font-size: 26px; letter-spacing: .02em; }
.slot .above { font-weight: 750; font-size: 24px; color: #444; margin-bottom: .35em; text-align: center; }
.fig { grid-row: 2; text-align: center; font-family: "Inter", sans-serif; font-weight: 800; letter-spacing: -.045em; line-height: 1; margin-top: .3em; color: #3D3D3D; white-space: nowrap; }
.fig.hl { color: var(--accent-2); }
.cap { grid-row: 3; text-align: center; font-size: 25px; font-weight: 500; color: #333; margin-top: .45em; line-height: 1.2; }
.source { flex: none; text-align: center; font-size: 18px; color: var(--muted); margin-top: 18px; }
{% endblock %}

{% block content %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="chart">
  <div class="baseline"></div>
  {% for bar in data.bars %}
  {% set h = heights[loop.index0] %}
  <div class="slot" style="grid-column: {{ loop.index }}">
    {% if h < 0.2 %}<div class="above" data-anim="fade">{{ bar.label | rich }}</div>{% endif %}
    <div class="bar{{ ' hl' if bar.highlight else '' }}" style="height: {{ (h * 100) | round(2) }}%" data-anim="grow-y" data-dur="1.1" data-order="{{ loop.index0 * 2 }}">
      {% if h >= 0.2 %}<div class="in">{{ bar.label | rich }}</div>{% endif %}
    </div>
  </div>
  <div class="fig{{ ' hl' if bar.highlight else '' }}" style="grid-column: {{ loop.index }}; font-size: {{ fig_size }}px" data-anim="fade-up" data-order="{{ loop.index0 * 2 + 1 }}">{{ bar.display }}</div>
  {% if bar.caption %}<div class="cap" style="grid-column: {{ loop.index }}" data-anim="fade" data-order="{{ loop.index0 * 2 + 1.5 }}">{{ bar.caption | rich }}</div>{% endif %}
  {% endfor %}
</section>
<div class="source" data-anim="fade" data-order="99">Source: {{ data.source }}</div>
{% endblock %}
