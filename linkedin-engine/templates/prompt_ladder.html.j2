{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import spark, send %}
{% block style %}
.head { flex: none; text-align: center; margin: 0 0 22px; font-size: 78px; max-height: 200px; }
.head h1 { margin: 0; font-size: 1em; }
.ladder { font-size: 27px; display: flex; flex-direction: column; justify-content: space-between; gap: .7em; }
.rung { display: flex; flex-direction: column; align-items: stretch; gap: .45em; }
.label { align-self: center; display: flex; align-items: center; gap: .3em; }
.label .icon { width: 1.95em; height: 1.95em; border: .08em solid var(--ink); border-radius: .3em; background: var(--panel); display: grid; place-items: center; }
.label .icon svg { width: 1.55em; height: 1.55em; }
.label .text { font-family: "Fraunces", serif; font-weight: 500; font-size: 1.42em; line-height: 1; padding: .2em .45em .25em; border-radius: .14em; letter-spacing: -.01em; }
.tone-bad .text { background: var(--bad); color: #fff; }
.tone-better .text { background: var(--warn); color: var(--ink); }
.tone-best .text { background: var(--good); color: var(--ink); }
.box { background: var(--panel); border: .06em solid #D5D2CC; border-radius: 1.05em; padding: .85em 1em .55em; box-shadow: 0 .25em .9em rgba(0,0,0,.06); }
.box .prompt { line-height: 1.38; white-space: pre-line; color: var(--ink-2); }
.box .prompt mark { background: #CFE3FF; padding: 0 .08em; border-radius: .12em; }
.box .bar { display: flex; align-items: center; gap: .7em; margin-top: .55em; color: var(--muted); }
.box .bar .plus { font-size: 1.5em; line-height: 1; font-weight: 300; color: var(--ink); }
.box .bar .grow { flex: 1; }
.box .bar svg { width: 1.6em; height: 1.6em; }
.meta { display: flex; justify-content: space-between; padding: 0 1.2em; color: var(--ink-2); font-size: .82em; }
.meta .model b { font-weight: 600; color: var(--ink); }
{% endblock %}

{% block content %}
{% if data.title %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.5"><h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1></header>
{% endif %}
<section class="fit ladder" data-fit="rungs" data-fit-max="1.35" data-fit-min="0.5">
  {% for rung in data.rungs %}
  <div class="rung">
    <div class="label tone-{{ rung.tone }}" data-anim="pop"><span class="icon">{{ spark(44) }}</span><span class="text">{{ rung.label | rich }}</span></div>
    <div class="box" data-anim="fade-up">
      <div class="prompt">{{ rung.prompt | rich }}</div>
      <div class="bar">
        <span class="plus">+</span><span class="grow"></span>
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="14" y="5" width="12" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="3"/><path d="M9 19 a11 11 0 0 0 22 0 M20 30 V35" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
        {{ send(46) }}
      </div>
    </div>
    {% if data.model_label %}<div class="meta" data-anim="fade"><span>Project ⌄</span><span class="model"><b>{{ data.model_label }}</b></span><span>Auto</span></div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endblock %}
