{# Small shared drawings. #}

{% macro burst(size=220, rays=12, x="-60px", y="-60px", side="left", color="var(--accent)") -%}
<svg class="burst" style="width:{{ size }}px;height:{{ size }}px;top:{{ y }};{{ side }}:{{ x }};color:{{ color }}" viewBox="-50 -50 100 100" aria-hidden="true">
  {%- for i in range(rays) %}
  {%- set angle = (360 / rays) * i %}
  <line x1="0" y1="-11" x2="0" y2="{{ -44 if i % 2 == 0 else -38 }}" stroke="currentColor" stroke-width="7.5" stroke-linecap="round" transform="rotate({{ angle }})"/>
  {%- endfor %}
</svg>
{%- endmacro %}

{% macro spark(size=48, color="var(--accent)") -%}
<svg style="width:{{ size }}px;height:{{ size }}px;color:{{ color }};flex:none" viewBox="-50 -50 100 100" aria-hidden="true">
  {%- for i in range(10) %}
  <line x1="0" y1="-8" x2="0" y2="{{ -44 if i % 2 == 0 else -36 }}" stroke="currentColor" stroke-width="9" stroke-linecap="round" transform="rotate({{ 36 * i }})"/>
  {%- endfor %}
</svg>
{%- endmacro %}

{% macro pin(size=46) -%}
<svg class="pin" style="width:{{ size }}px;height:{{ size }}px" viewBox="0 0 48 48" aria-hidden="true">
  <path d="M30 4 l14 14 -6 2 -7 7 1 9 -4 4 -9 -9 -10 13 -3 -1 13 -12 -9 -9 4 -4 9 1 7 -7z" fill="var(--bad)" stroke="#7a1410" stroke-width="1.4" stroke-linejoin="round"/>
  <path d="M33 8 l8 8" stroke="#ffffff" stroke-opacity=".55" stroke-width="2.4" stroke-linecap="round"/>
</svg>
{%- endmacro %}

{% macro check(filled=true, size=40) -%}
<svg style="width:{{ size }}px;height:{{ size }}px;flex:none" viewBox="0 0 40 40" aria-hidden="true">
  {%- if filled %}
  <circle cx="20" cy="20" r="18" fill="var(--accent)"/>
  <path d="M11.5 20.5 l6 6 11-12" fill="none" stroke="var(--bg)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
  {%- else %}
  <circle cx="20" cy="20" r="17" fill="none" stroke="var(--muted)" stroke-width="2.4"/>
  {%- endif %}
</svg>
{%- endmacro %}

{% macro send(size=46) -%}
<svg style="width:{{ size }}px;height:{{ size }}px;flex:none" viewBox="0 0 46 46" aria-hidden="true">
  <rect width="46" height="46" rx="12" fill="var(--accent)"/>
  <path d="M23 33 V14 M15 21 l8-8 8 8" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- endmacro %}

{% macro arrow_marker(id="arrow", color="var(--accent)") -%}
<marker id="{{ id }}" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="11" markerHeight="11" orient="auto-start-reverse">
  <path d="M1 1 L10 6 L1 11" fill="none" stroke="{{ color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
</marker>
{%- endmacro %}
