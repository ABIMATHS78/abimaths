{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import burst %}
{% block style %}
.head { flex: none; position: relative; z-index: 1; text-align: center; margin: 0 40px 26px; font-size: 96px; max-height: 300px; }
.head h1 { font-size: 1em; }
.head .line2 { display: block; color: var(--accent); font-weight: 500; letter-spacing: -.02em; }
.entries { column-count: 2; column-gap: 1.5em; column-rule: .06em solid var(--line); }
.e { break-inside: avoid; padding: .2em 0 .22em; border-bottom: .06em solid var(--line); line-height: 1.24; }
.e .n { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: .25em; }
.e b { font-weight: 750; }
{% endblock %}

{% block content %}
{{ burst(240, 12, "-82px", "-82px", "left") }}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}{% if data.title_line2 %}<span class="line2">{{ data.title_line2 | rich }}</span>{% endif %}</h1>
</header>
<section class="fit" data-fit="entries" data-fit-max="1.7" data-fit-min="0.42" style="font-size: 19px">
  <div class="entries">
  {% for entry in data.entries %}
    <div class="e" data-anim="fade" data-weight="0.35" data-dur="0.35"><span class="n">{{ loop.index }}.</span><b>{{ entry.term | rich }}</b> – {{ entry.definition | rich }}</div>
  {% endfor %}
  </div>
</section>
{% endblock %}
