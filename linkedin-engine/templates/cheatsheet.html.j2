{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import burst %}
{% set boxed = theme in ("paper", "ink", "mojeed-dark") %}
{% block style %}
.head { flex: none; position: relative; z-index: 1; max-height: 330px; margin-bottom: 30px; font-size: 104px; }
.head h1 { margin: 0; font-size: 1em; }
.head h1.condensed { font-size: 1.2em; }
.head .sub { margin-top: .28em; font-size: .3em; line-height: 1.2; color: var(--ink-2); font-family: "Fraunces", serif; font-weight: 500; font-variation-settings: "opsz" 48; }
.fit.body { font-size: 22px; line-height: 1.28; }
.panels { display: flex; gap: .95em; align-items: flex-start; }
.panels .col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: .85em; }
.panels.stretch { height: 100%; align-items: stretch; }
.panels.stretch .col > .panel:last-child { flex-grow: 1; }
.panel { background: var(--panel); border-radius: .45em; overflow: hidden; display: flow-root; }
.panel h3 { margin: 0; font-size: 1.02em; line-height: 1.12; letter-spacing: -.005em; }
.panel .inner { padding: .6em .75em .7em; display: flex; flex-direction: column; gap: .5em; }
/* tab look (cream) */
.tab .panel { border: .11em solid var(--accent); background: var(--panel); }
.tab .panel h3 { display: inline-block; background: var(--accent); color: var(--accent-ink); text-transform: uppercase; font-weight: 800; letter-spacing: .02em;
  padding: .5em 1.5em .45em .75em; clip-path: polygon(0 0, calc(100% - .8em) 0, 100% 100%, 0 100%); }
/* boxed look (paper, ink) */
.boxed .panel { border: .1em solid var(--panel-border); border-radius: .2em; }
.boxed .panel h3 { background: var(--panel-head); color: var(--panel-head-ink); border-bottom: .1em solid var(--panel-border); padding: .5em .7em .45em; font-weight: 750; }
.panel.tone-dark { background: var(--danger-panel); color: var(--danger-panel-ink); border-color: var(--danger-panel); }
.boxed .panel.tone-dark h3 { background: var(--bad); color: #fff; border-color: var(--bad); }
.tab .panel.tone-dark h3 { background: var(--bad); }
.panel.tone-accent { background: var(--accent-soft); }
.panel .num { color: var(--accent); margin-right: .3em; }
.tab .panel .num { color: inherit; }
/* blocks */
.b-text { margin: 0; }
.b-list, .b-steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: .28em; }
.b-list li { position: relative; padding-left: 1.05em; }
.b-list li::before { content: ""; position: absolute; left: .18em; top: .5em; width: .38em; height: .38em; border-radius: 50%; background: var(--accent); }
.tone-dark .b-list li::before { background: var(--bad); }
.b-steps { counter-reset: s; }
.b-steps li { counter-increment: s; position: relative; padding-left: 1.45em; }
.b-steps li .sub, .b-list li .sub { display: block; font-weight: 400; margin-top: .12em; }
.b-steps li::before { content: counter(s); position: absolute; left: 0; top: .08em; width: 1.12em; height: 1.12em; border-radius: 50%; background: var(--ink); color: var(--bg);
  font-size: .82em; font-weight: 800; display: grid; place-items: center; }
.tone-dark .b-steps li::before { background: var(--danger-panel-ink); color: var(--danger-panel); }
.b-table { width: 100%; border-collapse: collapse; font-size: .9em; }
.b-table th { background: var(--ink); color: var(--bg); text-align: left; font-weight: 700; padding: .35em .5em; }
.b-table td { padding: .32em .5em; border-bottom: .06em solid var(--line); vertical-align: top; }
.b-table td:first-child { font-weight: 650; }
.b-prompt { margin: 0; font-family: "JetBrains Mono", monospace; font-size: .8em; line-height: 1.4; white-space: pre-wrap; padding: .75em .85em; border-radius: .35em;
  background: var(--code-bg); color: var(--code-ink); border: .1em solid var(--code-bg); }
.boxed .b-prompt { background: var(--bg-2); color: var(--ink); border-color: var(--panel-border); }
.tone-dark .b-prompt { background: rgba(255,255,255,.08); border-color: transparent; }
.b-compare { display: grid; grid-template-columns: 1fr 1fr; gap: .5em; }
.b-compare > div { border-radius: .35em; padding: .45em .55em .55em; font-style: italic; font-size: .92em; line-height: 1.25; }
.b-compare .old { background: var(--bad-soft); }
.b-compare .new { background: var(--good-soft); }
.b-compare .tag { display: inline-block; font-style: normal; font-weight: 800; font-size: .72em; color: #fff; padding: .12em .45em; border-radius: .25em; margin-bottom: .35em; text-transform: uppercase; letter-spacing: .04em; }
.b-compare .old .tag { background: var(--bad); }
.b-compare .new .tag { background: var(--good); }
.b-note { margin: 0; font-weight: 750; border-left: .22em solid var(--accent); padding-left: .55em; }
/* headline inside the first column, as on the "explained like you're 5" sample */
.head-cell { background: none !important; border: 0 !important; overflow: visible; padding: .1em 0 .2em; }
.head-cell h1 { margin: 0; font-size: 4.3em; line-height: .9; }
.head-cell h1 .ln { display: block; }
.head-cell .sub { margin-top: .35em; font-size: 1.05em; line-height: 1.25; color: var(--ink-2); font-family: "Fraunces", serif; font-weight: 500; }
{% endblock %}

{% block script %}
<script>
window.__beforeFit = function () {
  const wrap = document.querySelector(".panels");
  const panels = Array.from(wrap.querySelectorAll(".panel"));
  const k = {{ data.columns if data.columns in (1, 2, 3) else 2 }};
  if (panels.some((el) => el.dataset.col)) {        // the spec chose the columns
    wrap.innerHTML = "";
    const cols = Array.from({ length: k }, () => { const c = document.createElement("div"); c.className = "col"; wrap.appendChild(c); return c; });
    panels.forEach((el) => cols[Math.min(k, Math.max(1, parseInt(el.dataset.col || "1", 10))) - 1].appendChild(el));
    return;
  }
  const gap = parseFloat(getComputedStyle(wrap).fontSize) * 0.9;
  window.__partitionColumns(wrap, panels, k, gap);
};
window.__layout = function () { document.querySelector(".panels").classList.add("stretch"); };
</script>
{% endblock %}

{% block content %}
{% if theme in ("cream", "mojeed") and data.headline_style != "condensed" and not data.headline_in_column %}{{ burst(200, 12, "-70px", "-70px", "right") }}{% endif %}
{% if not data.headline_in_column %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="{{ 'condensed' if data.headline_style == 'condensed' else 'display' }}" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
{% endif %}
<section class="fit body {{ 'boxed' if boxed else 'tab' }}" data-fit="panels" data-fit-max="1.6" data-fit-min="0.5">
  <div class="panels">
  {% if data.headline_in_column %}
    <article class="panel head-cell" data-col="1" data-anim="fade-up">
      <h1 class="display">{% for line in data.title.split("|") %}<span class="ln">{{ line | trim | rich }}</span>{% endfor %}</h1>
      {% if data.subtitle %}<div class="sub">{{ data.subtitle | rich }}</div>{% endif %}
    </article>
  {% endif %}
  {% for panel in data.panels %}
    <article class="panel tone-{{ panel.tone or 'normal' }}"{% if panel.column %} data-col="{{ panel.column }}"{% endif %} data-anim="fade-up">
      <h3>{% if data.number_panels != false %}<span class="num">{{ loop.index }}.</span>{% endif %}{{ panel.title | rich }}</h3>
      <div class="inner">
      {% for block in panel.blocks %}
        {% if block.kind == "text" %}<p class="b-text">{{ block.text | rich }}</p>
        {% elif block.kind == "note" %}<p class="b-note">{{ block.text | rich }}</p>
        {% elif block.kind == "prompt" %}<pre class="b-prompt">{{ block.text }}</pre>
        {% elif block.kind == "bullets" %}<ul class="b-list">{% for item in block["items"] %}<li>{{ item | rich }}</li>{% endfor %}</ul>
        {% elif block.kind == "steps" %}<ol class="b-steps">{% for item in block["items"] %}<li>{{ item | rich }}</li>{% endfor %}</ol>
        {% elif block.kind == "table" %}
          <table class="b-table">
            {% if block.header %}<tr>{% for cell in block.header %}<th>{{ cell | rich }}</th>{% endfor %}</tr>{% endif %}
            {% for row in block.rows %}<tr>{% for cell in row %}<td>{{ cell | rich }}</td>{% endfor %}</tr>{% endfor %}
          </table>
        {% elif block.kind == "compare" %}
          <div class="b-compare">
            <div class="old"><span class="tag">Old</span><br>{{ block.old | rich }}</div>
            <div class="new"><span class="tag">New</span><br>{{ block.new | rich }}</div>
          </div>
        {% endif %}
      {% endfor %}
      </div>
    </article>
  {% endfor %}
  </div>
</section>
{% endblock %}
