{% extends "_base.html.j2" %}
{#- A labelled drawing of an app screen: where to click, step by step. It is always marked as an illustration and is
    drawn from documented menu names, never passed off as a real screenshot. -#}
{% set landscape = width > height %}
{% block style %}
.head { flex: none; margin: 0 0 22px; font-size: {{ 66 if landscape else 76 }}px; max-height: {{ 150 if landscape else 240 }}px; padding-right: 250px; }
.head h1 { margin: 0; font-size: 1em; }
.head .sub { font-family: "Inter", sans-serif; font-size: .3em; font-weight: 500; letter-spacing: -.01em; color: var(--ink-2); margin-top: .45em; line-height: 1.3; }
.label {
  position: absolute; top: 58px; right: 56px; z-index: 3; rotate: 2deg;
  background: var(--ink); color: var(--bg); border-radius: 12px; padding: 12px 18px 11px; text-align: center;
  box-shadow: var(--shadow);
}
.label b { display: block; font-family: "Anton", Impact, sans-serif; font-weight: 400; font-size: 34px; letter-spacing: .08em; line-height: 1; }
.label span { display: block; font-size: 15px; font-weight: 600; letter-spacing: .02em; margin-top: 5px; opacity: .85; }
.stage { display: flex; flex-direction: column; gap: 20px; }
.stage > * { flex: none; }
.win {
  flex: none; display: flex; flex-direction: column; background: var(--panel);
  border: 3px solid var(--line-strong); border-radius: 22px; overflow: hidden; box-shadow: var(--shadow);
}
.bar { flex: none; height: 2.3em; display: flex; align-items: center; gap: .4em; padding: 0 .8em; background: var(--bg-2); border-bottom: 2px solid var(--line); }
.bar i { width: .62em; height: .62em; border-radius: 50%; background: var(--line); display: block; }
.bar .app { flex: 1; text-align: center; font-weight: 700; font-size: .82em; color: var(--muted); margin-right: 2.4em; }
.body { display: grid; grid-template-columns: {% if data.sidebar %}8.4em 1fr{% else %}1fr{% endif %}; }
.side { background: var(--bg-2); border-right: 2px solid var(--line); padding: .8em .55em; display: flex; flex-direction: column; gap: .3em; }
.side div { position: relative; overflow: visible; padding: .42em .6em; border-radius: .45em; font-size: .86em; color: var(--ink-2); white-space: nowrap; }
.side div.on { background: var(--panel); color: var(--ink); font-weight: 700; box-shadow: 0 0 0 2px var(--line); }
.side div.mark { position: relative; outline: .2em solid var(--accent); outline-offset: .08em; }
.main { padding: .9em 1.1em 1em; display: flex; flex-direction: column; gap: .55em; min-width: 0; }
.main h2 { font-family: "Inter", sans-serif; font-weight: 800; font-size: 1.25em; letter-spacing: -.02em; }
.tabs { display: flex; flex-wrap: wrap; gap: .25em .5em; border-bottom: 2px solid var(--line); padding-bottom: .1em; }
.tabs div { position: relative; padding: .25em .5em .4em; font-size: .86em; color: var(--muted); }
.tabs div.on { color: var(--ink); font-weight: 700; }
.tabs div.on::after { content: ""; position: absolute; left: .4em; right: .4em; bottom: -.18em; height: .2em; border-radius: .1em; background: var(--ink); }
.tabs div.mark { outline: .2em solid var(--accent); outline-offset: .05em; border-radius: .35em; }
.side .badge, .tabs .badge { left: auto; right: -.75em; top: -.35em; translate: none; font-size: .8em; }
.rows { display: flex; flex-direction: column; gap: .45em; }
.row { position: relative; display: flex; align-items: center; gap: .8em; padding: .6em .75em; border: 2px solid var(--line); border-radius: .6em; background: var(--panel); }
.row .txt { flex: 1; min-width: 0; }
.row .t { font-weight: 700; line-height: 1.2; }
.row .d { font-size: .78em; color: var(--muted); line-height: 1.25; margin-top: .15em; }
.row.mark, .composer.mark, .menu .item.mark { border-color: var(--accent); box-shadow: 0 0 0 .18em var(--accent); padding-left: 1.25em; }
.badge {
  position: absolute; left: -.65em; top: 50%; translate: 0 -50%; z-index: 2;
  width: 1.45em; height: 1.45em; border-radius: 50%; background: var(--accent); color: var(--accent-ink);
  display: grid; place-items: center; font-weight: 800; font-size: .9em; box-shadow: 0 0 0 .14em var(--panel);
}
.tog { flex: none; width: 2.4em; height: 1.35em; border-radius: 1em; background: var(--line); position: relative; }
.tog::after { content: ""; position: absolute; top: .17em; left: .17em; width: 1.01em; height: 1.01em; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
.tog.on { background: var(--ink); }
.tog.on::after { left: auto; right: .17em; }
.btn { flex: none; border: 2px solid var(--line-strong); border-radius: .5em; padding: .2em .65em; font-size: .82em; font-weight: 700; white-space: nowrap; }
.btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.chev { flex: none; font-size: 1.3em; line-height: 1; color: var(--muted); }
.menu { position: relative; align-self: flex-start; min-width: 60%; border: 2px solid var(--line-strong); border-radius: .6em; background: var(--panel); box-shadow: var(--shadow); padding: .3em; display: flex; flex-direction: column; gap: .2em; }
.menu .item { position: relative; padding: .4em .7em; border: 2px solid transparent; border-radius: .45em; font-weight: 600; }
.composer { position: relative; margin-top: auto; border: 2px solid var(--line-strong); border-radius: .8em; padding: .65em .8em; display: flex; align-items: flex-end; gap: .7em; background: var(--panel); }
.composer .typed { flex: 1; font-size: .9em; line-height: 1.3; color: var(--ink); }
.composer .typed.ph { color: var(--muted); }
.composer .send { flex: none; width: 1.7em; height: 1.7em; border-radius: .45em; background: var(--ink); color: var(--bg); display: grid; place-items: center; font-weight: 800; }
.foot { flex: none; display: grid; grid-template-columns: {{ '1fr 1fr' if (data.steps | length) > 2 else '1fr' }}; gap: .45em 1.2em; font-size: 23px; }
.step { display: flex; gap: .55em; align-items: flex-start; line-height: 1.25; }
.step .n { flex: none; width: 1.5em; height: 1.5em; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font-weight: 800; font-size: .9em; }
.path { flex: none; display: flex; flex-wrap: wrap; align-items: center; gap: .35em; font-size: 22px; font-weight: 700; }
.path span.seg { background: var(--chip-bg); color: var(--chip-ink); border: 2px solid var(--line); border-radius: .45em; padding: .15em .55em; }
.path span.arrow { color: var(--accent); font-weight: 800; }
.note { flex: none; font-size: 16px; color: var(--muted); line-height: 1.3; }
{% endblock %}

{% block content %}
<div class="label" data-anim="pop"><b>Illustration</b><span>not a screenshot</span></div>
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="fit stage" data-fit="screen" data-fit-max="1.7" data-fit-min="0.5" style="font-size: {{ 22 if landscape else 25 }}px">
  <div class="win" data-anim="fade-up">
    <div class="bar"><i></i><i></i><i></i><div class="app">{{ data.app }}</div></div>
    <div class="body">
      {% if data.sidebar %}
      <nav class="side">
        {% for item in data.sidebar %}<div class="{{ 'on' if loop.index0 == data.sidebar_active }}{{ ' mark' if loop.index0 == data.sidebar_mark }}">{{ item }}{% if loop.index0 == data.sidebar_mark and data.sidebar_step %}<span class="badge">{{ data.sidebar_step }}</span>{% endif %}</div>{% endfor %}
      </nav>
      {% endif %}
      <div class="main">
        {% if data.screen %}<h2>{{ data.screen | rich }}</h2>{% endif %}
        {% if data.tabs %}<div class="tabs">{% for tab in data.tabs %}<div class="{{ 'on' if loop.index0 == data.tab_active }}{{ ' mark' if loop.index0 == data.tab_mark }}">{{ tab }}{% if loop.index0 == data.tab_mark and data.tab_step %}<span class="badge">{{ data.tab_step }}</span>{% endif %}</div>{% endfor %}</div>{% endif %}
        {% if data.menu %}
        <div class="menu">
          {% for item in data.menu %}<div class="item{{ ' mark' if item.mark }}">{% if item.mark %}<span class="badge">{{ item.mark }}</span>{% endif %}{{ item.label | rich }}</div>{% endfor %}
        </div>
        {% endif %}
        {% if data.rows %}
        <div class="rows">
          {% for row in data.rows %}
          <div class="row{{ ' mark' if row.mark }}">
            {% if row.mark %}<span class="badge">{{ row.mark }}</span>{% endif %}
            <div class="txt"><div class="t">{{ row.label | rich }}</div>{% if row.detail %}<div class="d">{{ row.detail | rich }}</div>{% endif %}</div>
            {% if row.control == "toggle_on" %}<span class="tog on"></span>
            {% elif row.control == "toggle_off" %}<span class="tog"></span>
            {% elif row.control == "button" %}<span class="btn{{ ' primary' if row.mark }}">{{ row.button or "Open" }}</span>
            {% elif row.control == "chevron" %}<span class="chev">›</span>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% if data.composer %}
        <div class="composer{{ ' mark' if data.composer.mark }}">
          {% if data.composer.mark %}<span class="badge">{{ data.composer.mark }}</span>{% endif %}
          <div class="typed{{ ' ph' if not data.composer.text }}">{{ (data.composer.text or data.composer.placeholder or "Type here") | rich }}</div>
          <span class="send">↑</span>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% if data.path %}
  <div class="path" data-anim="fade-up">{% for seg in data.path %}{% if not loop.first %}<span class="arrow">→</span>{% endif %}<span class="seg">{{ seg }}</span>{% endfor %}</div>
  {% endif %}
  {% if data.steps %}
  <ol class="foot" style="list-style:none;padding:0;margin:0">
    {% for step in data.steps %}<li class="step" data-anim="fade-up"><span class="n">{{ loop.index }}</span><span>{{ step | rich }}</span></li>{% endfor %}
  </ol>
  {% endif %}
  <div class="note">{{ data.note or "Drawn from the official help pages to show where to click. Your screen may look a little different." }}</div>
</section>
{% endblock %}
