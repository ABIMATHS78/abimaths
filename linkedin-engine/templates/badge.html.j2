{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import spark %}
{% set side = [width, height - 76] | min %}
{% block style %}
.canvas { padding: 0 48px; }
.stage { position: absolute; inset: 0 0 76px 0; display: grid; place-items: center; }
svg.blob { position: absolute; width: {{ (side * 0.9) | round }}px; height: {{ (side * 0.9) | round }}px; left: 50%; top: 50%; transform: translate(-50%, -50%); }
svg.blob polygon { fill: var(--panel); }
.inner { position: relative; width: {{ (side * 0.56) | round }}px; max-height: {{ (side * 0.6) | round }}px; text-align: center; font-size: 112px; display: flex; flex-direction: column; align-items: center; }
.kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: .22em; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-2); margin: .5em 0 .2em; }
.title { font-family: "Fraunces", serif; font-weight: 600; line-height: 1.02; letter-spacing: -.025em; color: var(--ink); font-variation-settings: "opsz" 144; }
.sub { font-family: "Inter", sans-serif; font-weight: 600; font-size: .22em; color: var(--ink-2); margin-top: .8em; }
.credit { color: var(--ink); opacity: .8; }
.credit .right b { color: var(--ink); }
{% endblock %}

{% block content %}
<div class="stage">
  <svg class="blob" viewBox="-50 -50 100 100" aria-hidden="true" data-anim="zoom" data-order="0">
    <polygon points="{% for i in range(11) %}{% set a = (i * 360 / 11 + 9) * 3.14159265 / 180 %}{% set r = 46 + 3.4 * ((i * 7) % 5 - 2) / 2 %}{{ (r * (a | cos)) | round(2) }},{{ (r * (a | sin)) | round(2) }} {% endfor %}"/>
  </svg>
  <div class="inner" data-fit="badge" data-fit-max="1" data-fit-min="0.35">
    <div data-anim="pop" data-order="1">{{ spark(64) }}</div>
    {% if data.kicker %}<div class="kicker" data-anim="fade" data-order="2">{{ data.kicker | rich }}</div>{% endif %}
    <div class="title" data-anim="fade-up" data-order="3">{{ data.title | rich }}</div>
    {% if data.subtitle %}<div class="sub" data-anim="fade" data-order="4">{{ data.subtitle | rich }}</div>{% endif %}
  </div>
</div>
{% endblock %}
