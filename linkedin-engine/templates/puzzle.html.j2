{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import burst %}
{% block style %}
.canvas { --pad-top: 40px; --pad-x: 44px; }
.burst { position: absolute; opacity: .55; }
.head { flex: none; height: 196px; display: flex; align-items: center; position: relative; z-index: 1; }
.head .fitbox { width: 100%; height: 100%; display: flex; align-items: center; font-size: 74px; }
.head h1 { margin: 0; font: 800 1em/1.04 "Inter", sans-serif; letter-spacing: -.035em; color: #fffaf3; background: var(--accent);
  padding: .1em .22em .14em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.head h1 .tag { display: inline-block; background: var(--ink); color: #fffaf3; padding: 0 .16em .04em; margin-left: .06em; }
.puzzle { flex: none; position: relative; width: {{ pw }}px; height: {{ ph }}px; margin-top: 18px; }
.puzzle svg.lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.puzzle svg.lines path, .puzzle svg.lines rect { fill: none; stroke: var(--accent); stroke-width: 13; stroke-linecap: round; stroke-linejoin: round; }
.piece { position: absolute; overflow: hidden; font-size: 17px; line-height: 1.24; color: var(--ink); }
.piece .float { height: 100%; }
.piece .float.l { float: left; } .piece .float.r { float: right; }
.piece .name { display: inline-block; background: var(--ink); color: #fffaf3; font: 800 1.42em/1 "Inter", sans-serif; letter-spacing: -.01em;
  padding: .2em .4em .24em; border-radius: .14em; margin: 0 0 .45em; }
.piece .lbl { display: inline-block; background: var(--accent); color: #fffaf3; font: 700 .7em/1 "Inter", sans-serif; letter-spacing: .14em;
  text-transform: uppercase; padding: .26em .5em .22em; margin: .7em 0 .3em; }
.piece .plain { margin: 0; }
.piece .plain span { font: 500 1.3em/1.32 "Fraunces", serif; background: var(--bg-2); padding: .12em .3em .16em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.piece p { margin: 0; }
.piece ul { margin: 0; padding: 0; list-style: none; }
.piece li { margin: .08em 0; }
.piece li::before { content: "•"; color: var(--accent); font-weight: 800; margin-right: .45em; }
{% endblock %}

{% block content %}
{{ burst(230, 12, "-62px", "-70px", "right") }}
<header class="head">
  <div class="fitbox" data-fit="headline" data-fit-max="1" data-fit-min="0.5">
    <h1 data-anim="fade-up">{{ data.title | rich }} <span class="tag">{{ data.title_tag or "Explained" }}</span></h1>
  </div>
</header>
<section class="puzzle">
  <svg class="lines" viewBox="0 0 {{ pw }} {{ ph }}" aria-hidden="true">
    <rect x="0" y="0" width="{{ pw }}" height="{{ ph }}" rx="34"/>
    {% for d in paths %}<path d="{{ d }}"/>{% endfor %}
  </svg>
  {% for box in boxes %}
  {% set p = box.piece %}
  <div class="piece" data-fit="piece {{ loop.index }}" data-fit-max="1.3" data-fit-min="0.5" data-anim="fade-up"
       style="left: {{ box.l }}px; top: {{ box.t }}px; width: {{ box.w }}px; height: {{ box.h }}px">
    {% for f in box.floats %}<div class="float {{ 'l' if f.side == 'left' else 'r' }}" style="width: {{ f.w }}px;{% if f.h %} height: {{ f.h }}px;{% endif %}{% if f.shape %} shape-outside: {{ f.shape }};{% endif %}"></div>{% endfor %}
    <div class="name">{{ p.name | rich }}</div>
    <div class="lbl">In plain English:</div><p class="plain"><span>{{ p.plain | rich }}</span></p>
    <div class="lbl">Think of it like:</div><p>{{ p.like | rich }}</p>
    <div class="lbl">How to set it up:</div><ul>{% for step in p.setup %}<li>{{ step | rich }}</li>{% endfor %}</ul>
    <div class="lbl">Best for:</div><p>{{ p.best | rich }}</p>
    <div class="lbl">Biggest mistake people make:</div><p>{{ p.mistake | rich }}</p>
  </div>
  {% endfor %}
</section>
{% endblock %}
