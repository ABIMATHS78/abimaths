{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import send %}
{% set n = data.segments | length %}
{% block style %}
.head { flex: none; text-align: center; margin-bottom: 34px; font-size: 100px; max-height: 330px; }
.head h1 { margin: 0; font-size: 1em; }
.head .sub { font-family: "Fraunces", serif; font-weight: 400; font-size: .5em; letter-spacing: -.02em; margin-top: .12em; font-variation-settings: "opsz" 72; }
.anatomy { font-size: 25px; }
.grid { display: grid; grid-template-columns: 1fr 15.5em; grid-template-rows: repeat({{ n }}, auto) auto; column-gap: 1.2em; row-gap: .55em; position: relative; }
.cardbg { grid-column: 1; grid-row: 1 / span {{ n + 1 }}; margin: -.75em -.75em -.4em; background: var(--panel); border-radius: 1.4em; border: .05em solid #E2DCD2; box-shadow: var(--shadow); }
.seg { grid-column: 1; position: relative; z-index: 1; border-radius: .8em; padding: .7em .85em; color: #fff; line-height: 1.32; white-space: pre-line; }
.seg.tone-delete { background: #F01D1D; }
.seg.tone-keep { background: #EEA33E; }
.seg.tone-add { background: #3FBE46; }
.why { grid-column: 2; align-self: center; }
.why .label { font-weight: 800; font-size: 1.5em; letter-spacing: .01em; line-height: 1; }
.why .note { margin-top: .25em; font-size: .95em; line-height: 1.25; color: var(--ink); }
.why.tone-delete .label { color: #F01D1D; }
.why.tone-keep .label { color: #E39A33; }
.why.tone-add .label { color: #39B341; }
.bar { grid-column: 1; position: relative; z-index: 1; display: flex; align-items: center; gap: .6em; padding: .2em .15em 0; font-size: .85em; color: var(--ink); }
.bar .plus { font-size: 1.7em; font-weight: 300; line-height: 1; }
.bar .grow { flex: 1; }
.bar .model { font-weight: 600; }
.bar svg { width: 1.9em; height: 1.9em; }
{% endblock %}

{% block content %}
<header class="head" data-fit="headline" data-fit-max="1" data-fit-min="0.45">
  <h1 class="display" data-anim="fade-up">{{ data.title | rich }}</h1>
  {% if data.subtitle %}<div class="sub" data-anim="fade-up">{{ data.subtitle | rich }}</div>{% endif %}
</header>
<section class="fit anatomy" data-fit="segments" data-fit-max="1.3" data-fit-min="0.45">
  <div class="grid" style="padding: .8em .2em 1.1em .8em">
    <div class="cardbg" data-anim="fade"></div>
    {% for seg in data.segments %}
    <div class="seg tone-{{ seg.tone }}" style="grid-row: {{ loop.index }}" data-anim="fade-up">{{ seg.text | rich }}</div>
    <div class="why tone-{{ seg.tone }}" style="grid-row: {{ loop.index }}" data-anim="slide-right" data-step="0">
      <div class="label">{{ seg.label | rich }}</div>
      <div class="note">{{ seg.note | rich }}</div>
    </div>
    {% endfor %}
    <div class="bar" style="grid-row: {{ n + 1 }}" data-anim="fade">
      <span class="plus">+</span><span class="grow"></span>
      {% if data.model_label %}<span class="model">{{ data.model_label }} ⌄</span>{% endif %}
      {{ send(46) }}
    </div>
  </div>
</section>
{% endblock %}
