{% extends "_base.html.j2" %}
{% macro emblem(kind) -%}
{%- if kind == "burst" -%}<svg viewBox="-50 -50 100 100">{% for i in range(12) %}<line x1="0" y1="-10" x2="0" y2="-44" stroke="currentColor" stroke-width="5" stroke-linecap="round" transform="rotate({{ 30 * i }})"/>{% endfor %}</svg>
{%- elif kind == "rule" -%}<svg viewBox="0 0 100 20"><line x1="10" y1="10" x2="90" y2="10" stroke="currentColor" stroke-width="4"/></svg>
{%- elif kind == "network" -%}<svg viewBox="0 0 100 100"><path d="M50 22 L24 70 L76 70 Z" fill="none" stroke="currentColor" stroke-width="4"/><circle cx="50" cy="22" r="10" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="24" cy="70" r="10" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="76" cy="70" r="10" fill="none" stroke="currentColor" stroke-width="5"/></svg>
{%- elif kind == "dot" -%}<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="18" fill="currentColor"/></svg>
{%- elif kind == "square" -%}<svg viewBox="0 0 100 100"><rect x="30" y="30" width="40" height="40" fill="currentColor"/></svg>
{%- elif kind == "chain" -%}<svg viewBox="0 0 40 120"><path d="M20 4 V116" stroke="currentColor" stroke-width="3"/>{% for y in [18, 46, 74, 102] %}<circle cx="20" cy="{{ y }}" r="7" fill="none" stroke="currentColor" stroke-width="3"/>{% endfor %}</svg>
{%- elif kind == "warning" -%}<svg viewBox="0 0 100 100"><path d="M50 12 L92 86 H8 Z" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round"/><path d="M50 40 V62" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><circle cx="50" cy="74" r="4.5" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro %}
{% block style %}
.canvas { padding: 0 20px; }
.caption { position: absolute; left: 0; right: 0; top: 34px; text-align: center; font-family: "Fraunces", serif; font-weight: 700; font-size: 58px; letter-spacing: -.02em; line-height: 1; }
.shelf { position: absolute; left: 20px; right: 20px; top: {{ 120 if data.caption else 26 }}px; bottom: 100px; display: flex; align-items: flex-end; }
.spine { position: relative; flex: none; border-radius: 7px 7px 3px 3px; overflow: hidden;
  box-shadow: inset 7px 0 9px -4px rgba(255, 255, 255, .18), inset -10px 0 14px -6px rgba(0, 0, 0, .45), 3px 0 4px rgba(0, 0, 0, .28); }
.spine::before { content: ""; position: absolute; inset: 0; opacity: .5; mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.1 0.06' numOctaves='2' seed='5'/><feColorMatrix values='0 0 0 0 .55  0 0 0 0 .5  0 0 0 0 .45  0 0 0 .7 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
.spine::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.22), rgba(255,255,255,.1) 22%, rgba(255,255,255,0) 45%, rgba(0,0,0,.06) 75%, rgba(0,0,0,.3)); }
.band { position: absolute; left: 0; right: 0; height: 2px; opacity: .45; background: currentColor; z-index: 1; }
.title { position: absolute; top: 6%; bottom: 17%; left: 6%; right: 6%; z-index: 2; writing-mode: vertical-rl; display: flex; align-items: center; justify-content: center; text-align: center;
  font-family: "Fraunces", serif; font-weight: 500; line-height: 1.05; letter-spacing: -.01em; font-variation-settings: "opsz" 72; }
.emblem { position: absolute; z-index: 2; left: 50%; bottom: 6.5%; transform: translateX(-50%); width: 34%; display: grid; place-items: center; }
.emblem svg { width: 100%; height: auto; max-height: 120px; }
.floor { position: absolute; left: 0; right: 0; bottom: 76px; height: 24px; background: linear-gradient(#CDBFAB, #E7DDCD); }
{% endblock %}

{% block content %}
{% if data.caption %}<div class="caption" data-anim="fade-up">{{ data.caption | rich }}</div>{% endif %}
<div class="floor"></div>
<div class="shelf">
  {% for book in data.books %}
  {% set s = spines[loop.index0] %}
  <div class="spine" style="width: {{ s.width }}px; height: {{ (s.height * 100) | round(1) }}%; background: {{ s.bg }}; color: {{ s.ink }}" data-anim="fade-up" data-dur="0.5">
    <span class="band" style="top: 3.2%"></span><span class="band" style="top: 4%"></span>
    <span class="band" style="bottom: 3.6%"></span>
    <div class="title" data-fit="spine-{{ loop.index }}" data-fit-max="1" data-fit-min="0.3" style="font-size: {{ (s.width * 0.46) | round }}px">{{ book.title | plain }}</div>
    {% if book.emblem and book.emblem != "none" %}<div class="emblem">{{ emblem(book.emblem) }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endblock %}
