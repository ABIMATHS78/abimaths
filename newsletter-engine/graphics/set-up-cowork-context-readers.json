{
 "template": "cheatsheet",
 "theme": "learn",
 "data": {
  "title": "File 2: *My readers*",
  "subtitle": "Context file 2 of 3. Who reads your work, and what each one needs.",
  "headline_style": "serif",
  "number_panels": false,
  "columns": 2,
  "panels": [
   {
    "title": "What goes in",
    "column": 1,
    "blocks": [
     {
      "kind": "bullets",
      "items": [
       "Your **3 to 5** main readers",
       "What each one **needs** from you",
       "What they **push back** on",
       "The **format and length** they prefer"
      ]
     }
    ]
   },
   {
    "title": "Example entry 1",
    "column": 1,
    "blocks": [
     {
      "kind": "text",
      "text": "**Finance director.** Reads on her phone between meetings."
     },
     {
      "kind": "bullets",
      "items": [
       "Always include: the decision you need",
       "Avoid: background before the answer"
      ]
     }
    ]
   },
   {
    "title": "Example entry 2",
    "column": 1,
    "blocks": [
     {
      "kind": "text",
      "text": "**My team.** Reads the Monday update."
     },
     {
      "kind": "bullets",
      "items": [
       "Always include: who does what by when",
       "Avoid: long paragraphs"
      ]
     }
    ]
   },
   {
    "title": "Let Claude interview you",
    "column": 2,
    "blocks": [
     {
      "kind": "prompt",
      "text": "Ask me, one at a time, about the people who read my work most. Write one section per reader, ending with Always include and Avoid."
     }
    ],
    "tone": "accent"
   },
   {
    "title": "Why it matters",
    "column": 2,
    "blocks": [
     {
      "kind": "text",
      "text": "Claude writes for **the person who reads it**, not just for you."
     }
    ]
   },
   {
    "title": "Watch out",
    "column": 2,
    "blocks": [
     {
      "kind": "text",
      "text": "Describe **roles and needs**, not private details about people."
     }
    ],
    "tone": "dark"
   }
  ]
 }
}