{
 "template": "cheatsheet",
 "theme": "learn",
 "data": {
  "title": "File 1: *About me*",
  "subtitle": "Context file 1 of 3. Who you are, so Claude stops guessing.",
  "headline_style": "serif",
  "number_panels": false,
  "columns": 2,
  "panels": [
   {
    "title": "What goes in",
    "column": 1,
    "blocks": [
     {
      "kind": "bullets",
      "items": [
       "**Role** and type of organisation",
       "**Main work**: the jobs you do most",
       "**Priorities** this quarter",
       "**People** you work with most",
       "**Terms** and acronyms you use"
      ]
     }
    ]
   },
   {
    "title": "Example lines",
    "column": 1,
    "blocks": [
     {
      "kind": "bullets",
      "items": [
       "Role: [job title] in a [type of] team, reporting to [who]",
       "Priority: [project], due [month]",
       "Terms: [acronym] means [meaning]"
      ]
     }
    ]
   },
   {
    "title": "Where it lives",
    "column": 1,
    "blocks": [
     {
      "kind": "text",
      "text": "Claude work → Context → **About me.md**. Read me first.md tells Claude to read it before any writing task."
     }
    ]
   },
   {
    "title": "Let Claude interview you",
    "column": 2,
    "blocks": [
     {
      "kind": "prompt",
      "text": "Interview me for About me.md. One question at a time, eight at most. Then write it under Role, Main work, Current priorities, People, Terms. One screen."
     }
    ],
    "tone": "accent"
   },
   {
    "title": "Keep it useful",
    "column": 2,
    "blocks": [
     {
      "kind": "bullets",
      "items": [
       "One screen of bullets",
       "Facts and reasons, not wishes",
       "Update it when priorities change",
       "Check it: a new colleague could follow it"
      ]
     }
    ],
    "tone": "dark"
   }
  ]
 }
}